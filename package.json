{
  "name": "pro-dat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.2",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @pro-dat/api --filter @pro-dat/mobile dev",
    "dev:api": "pnpm --filter @pro-dat/api dev",
    "dev:mobile": "pnpm --filter @pro-dat/mobile dev",
    "doctor": "pnpm --filter @pro-dat/mobile exec expo-doctor",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.1",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
