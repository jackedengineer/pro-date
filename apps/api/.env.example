# Copy this file to apps/api/.env. Never commit the real values.
CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_SECRET_KEY
DATABASE_URL=YOUR_NEON_POOLED_CONNECTION_STRING
MIGRATION_DATABASE_URL=YOUR_NEON_DIRECT_CONNECTION_STRING
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

HOST=0.0.0.0
LOG_LEVEL=debug
NODE_ENV=development
PORT=3000

# Keep off until 0013_chat_notifications is applied to a confirmed database.
# This enables preference/device storage only; live push delivery is not ready yet.
NOTIFICATIONS_ENABLED=false
# Optional EAS project UUID. Device binding stays unavailable until this is configured.
EXPO_PROJECT_ID=
