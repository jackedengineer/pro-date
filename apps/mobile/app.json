{
  "expo": {
    "name": "Merge",
    "icon": "./assets/brand/icon.png",
    "slug": "pro-date",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "prodate",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "dev.jacked.merge",
      "supportsTablet": false
    },
    "android": {
      "package": "dev.jacked.merge",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#5A2E4F"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F5",
          "image": "./assets/brand/splash.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "messages",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Merge uses your location to show relevant people nearby. Your exact location is never shown on your profile."
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false,
          "photosPermission": "Merge uses only the photos you choose to build your dating profile."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ad814c70-1bb4-4ec4-add9-21608e347972"
      }
    },
    "owner": "jackedengineer"
  }
}
