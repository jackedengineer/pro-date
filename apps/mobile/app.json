{
  "expo": {
    "name": "Merge",
    "icon": "./assets/brand/icon.png",
    "slug": "pro-date",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "prodate",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.prodate.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "com.prodate.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#5A2E4F"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F5",
          "image": "./assets/brand/splash.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        { "defaultChannel": "messages", "enableBackgroundRemoteNotifications": false }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Merge uses your location to show relevant people nearby. Your exact location is never shown on your profile."
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false,
          "photosPermission": "Merge uses only the photos you choose to build your dating profile."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
