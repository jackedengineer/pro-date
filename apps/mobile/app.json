{
  "expo": {
    "name": "ProDate",
    "slug": "pro-date",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "prodate",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.prodate.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "com.prodate.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ProDate uses your location to show relevant people nearby. Your exact location is never shown on your profile."
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false,
          "photosPermission": "ProDate uses only the photos you choose to build your dating profile."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
